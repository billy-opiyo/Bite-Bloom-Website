 # Neon PostgreSQL pooled connection string. Keep the -pooler host for runtime connections.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Auth.js secret used to sign authentication tokens. Create a unique random value per environment.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional development owner created by `npm run db:seed`. Never use these example values in production.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="use-a-unique-password-with-at-least-12-characters"
SEED_ADMIN_NAME="Bite & Bloom Owner"

# Safaricom Daraja M-Pesa STK Push. Use sandbox values while developing.
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://your-public-domain.example/api/payments/mpesa/callback"
# CustomerPayBillOnline for PayBill, CustomerBuyGoodsOnline for Till/Buy Goods.
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"

# Business WhatsApp number in international digits only, used for Cash on Delivery confirmation links.
NEXT_PUBLIC_WHATSAPP_ORDER_PHONE="254711222333"

# Public storefront contact and location configuration. These are not secrets.
NEXT_PUBLIC_CONTACT_EMAIL="hello@biteandbloom.co.ke"
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY="+254 711 222 333"
NEXT_PUBLIC_CONTACT_PHONE="+254711222333"
NEXT_PUBLIC_STUDIO_ADDRESS="13 Riverside Lane, Kilimani · Nairobi"
NEXT_PUBLIC_MAP_SEARCH_URL="https://www.google.com/maps/search/?api=1&query=Kilimani%2C%20Nairobi"
NEXT_PUBLIC_MAP_EMBED_URL="https://www.google.com/maps?q=Kilimani%20Nairobi&output=embed"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com"
NEXT_PUBLIC_TIKTOK_URL="https://tiktok.com"

# Secret used by the trusted scheduler to release expired inventory reservations.
CRON_SECRET="replace-with-a-long-random-scheduler-secret"
